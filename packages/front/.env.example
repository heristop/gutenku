# App URL (used for canonical URLs, hreflang, sitemap)
VITE_APP_URL=https://gutenku.xyz

# Server endpoints
VITE_SERVER_HOST=http://localhost:4000
VITE_WEBSOCKET_HOST=ws://localhost:4000

# Self-hosted Umami. Setting both of these switches analytics on. The tracker
# sets no cookie and writes no identifier on the visitor's device, which is what
# a cookie banner asks about (it still derives a pseudonymous visitor hash
# server-side). Takes precedence over VITE_CLOUDFLARE_TOKEN, which is then
# ignored rather than sent in parallel.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
# Only when the collect API answers on another origin than the script.
VITE_UMAMI_HOST_URL=

# Cloudflare Web Analytics. Cookieless like Umami, and cheaper: a token, nothing
# to host. Page views only — the vendor exposes no event API. Ranks behind Umami
# when both are set. Leave every value empty to load no tag at all.
VITE_CLOUDFLARE_TOKEN=
