# Production environment for native app builds (Capacitor)
VITE_APP_URL=https://gutenku.xyz

# Production server endpoints
VITE_SERVER_HOST=https://gutenku.xyz
VITE_WEBSOCKET_HOST=wss://gutenku.xyz

# Self-hosted Umami. Filling both switches analytics on and takes precedence
# over the Cloudflare token below. Left empty on purpose — turning measurement
# on is a deliberate move, not a side effect of a deploy.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST_URL=

# Cloudflare Web Analytics — see .env.example. Left empty on purpose, like the Umami pair.
VITE_CLOUDFLARE_TOKEN=
