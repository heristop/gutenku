{ext}`));\n    for (const indexFile of indexFiles) {\n      if (existsSync(indexFile)) return indexFile;\n    }\n    return null;\n  }\n\n  return path;\n}\n\nexport function isImportablePath(path: string, fileExtensions: string[]): boolean {\n  return !!getImportablePath(path, fileExtensions);\n}\n"]}