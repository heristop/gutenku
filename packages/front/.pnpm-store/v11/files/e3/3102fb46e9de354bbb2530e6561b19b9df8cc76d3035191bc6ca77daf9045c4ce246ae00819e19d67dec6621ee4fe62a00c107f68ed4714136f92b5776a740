Config = await prepareConfig({\n      ...options,\n      outDir: declarationDir,\n      declarationDir: undefined,\n      output: config.output,\n      aliasTrie: undefined\n    });\n  }\n\n  return ({ fileContents, filePath }) => {\n    let activeConfig = config;\n    const isDeclaration =\n      declarationConfig && (filePath.endsWith('.d.ts') || (declarationDir && filePath.startsWith(declarationDir)));\n\n    if (isDeclaration) {\n      activeConfig = declarationConfig!;\n    }\n\n    return replaceAliasString({\n      config: activeConfig,\n      file: filePath,\n      code: fileContents,\n      resolveFullPath: options?.resolveFullPaths,\n      resolveFullExtension: options?.resolveFullExtension\n    });\n  };\n}\n"]}