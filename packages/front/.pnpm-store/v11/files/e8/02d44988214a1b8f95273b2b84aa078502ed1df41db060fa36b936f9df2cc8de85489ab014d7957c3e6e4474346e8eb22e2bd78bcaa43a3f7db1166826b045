{
  "name": "import-without-cache",
  "type": "module",
  "version": "0.4.1",
  "description": "Import ES modules without cache.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/import-without-cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/import-without-cache.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/import-without-cache/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.2"
  },
  "prettier": "@sxzz/prettier-config",
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "node --test tests/index.test.ts",
    "test:bun": "bun test tests/bun.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp"
  }
}