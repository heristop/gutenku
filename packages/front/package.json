{
  "name": "@gutenku/front",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite-ssg build",
    "start": "vite serve --host",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:a11y": "cypress run --spec 'cypress/e2e/accessibility.cy.ts'",
    "test:gui": "cypress run --headed --no-exit",
    "lint": "oxlint --fix",
    "lint:css": "stylelint 'src/**/*.{vue,scss,css}'",
    "typecheck": "vue-tsc --noEmit",
    "lighthouse": "vite build && lhci autorun",
    "cap:build": "pnpm build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:sync": "npx cap sync",
    "generate:assets": "node scripts/build-app-icons.mjs",
    "cap:assets": "pnpm generate:assets && npx capacitor-assets generate",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "generate:image-sizes": "tsx scripts/article-image-sizes.ts"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@chenglou/pretext": "^1.0.0",
    "@fingerprintjs/botd": "^2.0.0",
    "@gutenku/shared": "workspace:*",
    "@unhead/vue": "^2.1.17",
    "@urql/vue": "^2.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "graphql": "^16.15.0",
    "graphql-ws": "^6.4.1",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@babel/types": "^8.1.0",
    "@capacitor/assets": "^4.0.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@lhci/cli": "^0.16.0",
    "@types/node": "^26.6.6",
    "@types/webfontloader": "^1.6.38",
    "@types/zen-observable": "^0.8.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "beasties": "^0.5.5",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "jsdom": "^30.1.3",
    "postcss-html": "^2.0.0",
    "purgecss": "^8.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.107.1",
    "sass-loader": "^17.1.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "licence": "UNLICENSED"
}
